# AI 날씨 비서용 Google Gemini API 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Supabase 프로젝트 설정(Settings > API)에서 확인. 비워두면 로그인 없이 날씨 화면만 동작
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 배포 주소. 회원가입 메일·구글 로그인 리다이렉트와 링크 미리보기 이미지 주소에 사용
# 로컬 개발 시 비워두면 http://localhost:3000 사용
NEXT_PUBLIC_SITE_URL=
